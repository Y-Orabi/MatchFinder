@model IEnumerable<MatchFinder.Domain.Entities.ApplicationUser>

@{
    ViewData["Title"] = "Admin Dashboard - User Management";
}

<div class="container mt-4">
    <h2>Platform Users & Host Approvals</h2>
    <hr />

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <table class="table table-striped table-hover mt-3">
        <thead>
            <tr>
                <th>Full Name</th>
                <th>Email</th>
                <th>Skill Level</th>
                <th>Host Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td>@user.SkillLevel</td>
                    <td>
                        @if (user.IsApprovedHost)
                        {
                            <span class="badge bg-success">Approved Host</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Pending / Player</span>
                        }
                    </td>
                    <td>
                        @if (!user.IsApprovedHost)
                        {
                            <form asp-action="ApproveHost" asp-route-id="@user.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-success">Approve Host</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>