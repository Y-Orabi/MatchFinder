@model MatchFinder.Domain.Entities.Match

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-body">
            <span class="badge bg-primary mb-2">@Model.SportType</span>
            <h2>@Model.Title</h2>
            <p class="text-muted">Hosted by: <strong>@Model.Host?.FullName</strong></p>

            <hr />

            <div class="row mb-3">
                <div class="col-md-6">
                    <p><strong>Venue:</strong> @Model.Venue</p>
                    <p><strong>Date & Time:</strong> @Model.MatchDate.ToString("f")</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Status:</strong> @Model.Status</p>
                    <p><strong>Capacity:</strong> @Model.CurrentPlayersCount / @Model.MaxPlayers Players</p>
                </div>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            <div class="mt-4">
                <form asp-action="Join" asp-route-id="@Model.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-success">Join Match</button>
                </form>

                <form asp-action="Leave" asp-route-id="@Model.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-danger">Leave Match</button>
                </form>

                <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
            </div>
        </div>
    </div>
</div>